// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id            Int      @id @default(autoincrement())
  nombre        String   // Nombre comercial (Ej: Hotel Sunset)
  razonSocial   String   // Nombre legal (Ej: Inversiones Sunset S.A.S)
  nit           String   // Identificador fiscal
  direccion     String?
  ciudad        String?
  departamento  String?
  pais          String?
  telefono      String?
  moneda        String   @default("COP") // Ej: COP, USD, EUR
  horaCheckIn   String   @default("13:00")
  horaCheckOut  String   @default("12:00")
  ivaPorcentaje Float    @default(19.0)  // Porcentaje de impuesto
  logoUrl       String?  // Para el logo (lo usaremos en el futuro)

  // Relaciones: Un hotel tiene muchos de estos elementos
  usuarios      Usuario[]
  habitaciones  Habitacion[]
  huespedes     Huesped[]
  reservas      Reserva[]
  gastos        Gasto[]
  temporada     Temporada[]
}

model Usuario {
  id       Int    @id @default(autoincrement())
  hotelId  Int    // ADN del hotel
  hotel    Hotel  @relation(fields: [hotelId], references: [id])
  nombre   String
  email    String @unique
  password String
  rol      String @default("Recepcionista")
}

model Habitacion {
  id          Int      @id @default(autoincrement())
  hotelId     Int      // ADN del hotel
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  numero      String
  tipo        String
  precioBase  Float
  estado      String   @default("Disponible")
  reservas    Reserva[]

  @@unique([hotelId, numero]) // Regla de oro: En un mismo hotel, no pueden haber 2 habitaciones con el mismo número
}

model Huesped {
  id              Int      @id @default(autoincrement())
  hotelId         Int      // ADN del hotel
  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  tipoDocumento   String
  numeroDocumento String
  nombre          String
  apellido        String
  email           String
  telefono        String?
  notas           String?
  reservas        Reserva[]

  @@unique([hotelId, numeroDocumento]) // Regla de oro: En un mismo hotel, no pueden haber 2 huéspedes con la misma cédula
}

model Reserva {
  id            Int      @id @default(autoincrement())
  hotelId       Int      // ADN del hotel
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  fechaCheckIn  DateTime
  fechaCheckOut DateTime
  estado        String   @default("Pendiente")
  precioTotal   Float

  // 🆕 DATOS DE FACTURACIÓN (se llenan al momento del check-out)
  numeroFactura    Int?     // Consecutivo por hotel. Null = aún no facturada
  nochesReservadas Int?     // Noches contratadas originalmente
  subtotalSinIva   Float?   // Precio prometido congelado (sin IVA)
  ivaPorcentaje    Float?   // IVA aplicado al facturar
  ivaMonto         Float?   // Monto del IVA cobrado
  nombreTemporada  String?  // Temporada que aplicó (informativo del recibo)
  detalleNoches    Json?    // Desglose noche por noche (estructura completa)

  habitacionId  Int
  huespedId     Int
  habitacion    Habitacion @relation(fields: [habitacionId], references: [id])
  huesped       Huesped    @relation(fields: [huespedId], references: [id])
}

model Gasto {
  id        Int      @id @default(autoincrement())
  hotelId   Int      // ADN del hotel
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  concepto  String
  monto     Float
  categoria String
  estado    String   @default("Pagado")
  fecha     DateTime @default(now())
}

model Temporada {
  id            Int      @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel    @relation(fields: [hotelId], references: [id])
  nombre        String   // Ej: "Semana Santa"
  fechaInicio   DateTime
  fechaFin      DateTime
  porcentaje    Float    // Ej: 20 (para +20%), -10 (para -10%)
  diasAplicables String  @default("0,1,2,3,4,5,6") // 0=Domingo, 6=Sabado
}